---
layout: default
---
{% if page.cv_pdf %}
  {% if page.cv_pdf contains '://' %}
    {% assign cv_pdf_url = page.cv_pdf %}
  {% else %}
    {% assign cv_pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
  {% endif %}
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.cv_pdf %}
      <p class="mt-1 mb-0">
        <a class="cv-download-link" href="{{ cv_pdf_url }}" target="_blank" rel="noopener noreferrer">
          <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
          Download CV
        </a>
      </p>
    {% endif %}
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if page.cv_pdf %}
    <div class="cv-view-switcher" data-cv-tabs>
      <div class="cv-view-tabs" role="tablist" aria-label="CV format">
        <button
          id="cv-pdf-tab"
          class="cv-view-tab"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="cv-pdf-panel"
          data-cv-tab="pdf"
        >
          <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
          PDF
        </button>
        <button
          id="cv-html-tab"
          class="cv-view-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="cv-html-panel"
          tabindex="-1"
          data-cv-tab="html"
        >
          <i class="fa-solid fa-code" aria-hidden="true"></i>
          HTML
        </button>
      </div>

      <section id="cv-pdf-panel" role="tabpanel" aria-labelledby="cv-pdf-tab" data-cv-panel="pdf">
        {% include cv/pdf-viewer.liquid %}
      </section>

      <section id="cv-html-panel" role="tabpanel" aria-labelledby="cv-html-tab" data-cv-panel="html" hidden>
        {% include cv/html-view.liquid %}
      </section>
    </div>
  {% else %}
    {% include cv/html-view.liquid %}
  {% endif %}
</div>

{% if page.cv_pdf %}
  <script defer src="{{ '/assets/js/cv-tabs.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
